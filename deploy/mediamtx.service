[Unit]
Description=MediaMTX Streaming Server (RTSP/RTMP/WebRTC)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=mediamtx
Group=mediamtx
WorkingDirectory=/var/lib/mediamtx
ExecStart=/usr/local/bin/mediamtx /var/lib/mediamtx/mediamtx.yml
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/mediamtx
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
